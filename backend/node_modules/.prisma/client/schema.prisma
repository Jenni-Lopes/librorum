generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Livro {
  id           Int     @id @default(autoincrement())
  googleBookId String
  titulo       String
  autores      String?
  imagem       String?
  paginas      Int?

  nota   Float?
  status String @default("QUERO_LER") // Status: "QUERO_LER", "LENDO", "LIDO"

  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model User {
  id    Int    @id @default(autoincrement())
  email String @unique
  name  String
  senha String

  livros Livro[]

  createdAt DateTime @default(now())
}
